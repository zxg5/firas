# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE DATABASE & AUTH CONFIGURATION
# ==========================================
# احصل على هذه البيانات من لوحة تحكم مشروعك في Supabase (Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ==========================================
# SMS GATEWAY PROVIDER CONFIGURATION
# ==========================================
# مزود الرسائل النصية القصيرة المعتمد (مثل تقنيات Taqnyat أو Unifonic)
# للربط مع Taqnyat:
TAQNYAT_BEARER_TOKEN="your_taqnyat_bearer_token"
TAQNYAT_SENDER="WAFA"

# للربط مع Unifonic:
UNIFONIC_APP_SID="your_unifonic_appsid"
UNIFONIC_SENDER="WAFA"

# ==========================================
# PLATFORM SUPER ADMIN PROTECTED NUMBERS & EMAILS
# ==========================================
# أرقام الجوال والبريد المعتمد حصراً لصلاحية مدير منصة وفاء
WAFA_SUPER_ADMIN_PHONES="0551234567,0534067866"
WAFA_SUPER_ADMIN_EMAIL="frasalfyfy7@gmail.com"

# ==========================================
# REAL EMAIL SERVICE (طريقة تفعيل وصول الرسائل إلى بريدك الحقيقي)
# ==========================================
# الخيار 1: عبر حساب Gmail الشخصي أو بريد العمل (أسهل وأسرع طريقة مجانية):
GMAIL_USER="frasalfyfy7@gmail.com"
GMAIL_APP_PASSWORD="xxxx xxxx xxxx xxxx" # كلمة مرور التطبيقات من Google المكونة من 16 حرفاً

# الخيار 2: عبر خدمة Resend (أضمن وصولاً لـ Inbox دون سبام):
RESEND_API_KEY="re_123456789"
RESEND_FROM="WAFA Loyalty <onboarding@resend.dev>"

# الخيار 3: عبر أي سيرفر SMTP مخصص:
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="frasalfyfy7@gmail.com"
SMTP_PASS="your-password"
SMTP_FROM="WAFA Loyalty | منصة وفاء <no-reply@wafa.sa>"

ADMIN_NOTIFICATION_EMAIL="frasalfyfy7@gmail.com"
SUPPORT_PHONE="0534067866"

# ==========================================
# SAUDI PAYMENT GATEWAY (بوابة الدفع ميسر لمدى و Apple Pay)
# ==========================================
MOYASAR_API_KEY="sk_test_xxxxxxxxxxxxxxxx"
VITE_MOYASAR_KEY="pk_test_xxxxxxxxxxxxxxxx"
