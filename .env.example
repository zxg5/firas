# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==========================================
# SUPABASE DATABASE & AUTH CONFIGURATION
# ==========================================
# احصل على هذه البيانات من لوحة تحكم مشروعك في Supabase (Settings -> API)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"

# ==========================================
# SMS GATEWAY PROVIDER CONFIGURATION
# ==========================================
# مزود الرسائل النصية القصيرة المعتمد (مثل تقنيات Taqnyat أو Unifonic)
# للربط مع Taqnyat:
TAQNYAT_BEARER_TOKEN="your_taqnyat_bearer_token"
TAQNYAT_SENDER="WAFA"

# للربط مع Unifonic:
UNIFONIC_APP_SID="your_unifonic_appsid"
UNIFONIC_SENDER="WAFA"

# ==========================================
# PLATFORM SUPER ADMIN PROTECTED NUMBERS
# ==========================================
# أرقام الجوال المعتمدة حصراً لصلاحية مدير منصة وفاء (مفصولة بفاصلة)
WAFA_SUPER_ADMIN_PHONES="0551234567,0555112233"
